{
  "description": "sdlc-agents: session budget for pipeline runs (agent-base §9.5 step 3a)",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/session_budget.py\" PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/session_budget.py\" PostToolUseFailure",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
